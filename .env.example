# Huomo - Barber Management System
# Variables de entorno para el cliente frontend (Vite)
# IMPORTANTE: Solo incluir variables prefijadas con VITE_ en el cliente.
# NUNCA incluir la clave `service_role` ni secretos de base de datos aquí.

# URL del proyecto Supabase (Dashboard -> Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública de Supabase (Dashboard -> Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
